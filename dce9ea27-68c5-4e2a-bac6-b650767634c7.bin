<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="description" content="Sofá cama y mesas de comedor de madera con sillas. Muebles cómodos y versátiles para espacios reales."><title>OAKLAND · Sofá cama y mesa de comedor</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#f6f3ee;--ink:#1d1b18;--mute:#5f5a52;--line:#e2dbcf;--oak:#8a4b17;--card:#fffdfa;--shadow:0 1px 2px rgba(29,27,24,.06),0 18px 40px -18px rgba(29,27,24,.28);color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#171513;--ink:#f2ede4;--mute:#b0a799;--line:#35302a;--oak:#d9955a;--card:#211e1a;--shadow:0 1px 2px rgba(0,0,0,.4),0 18px 40px -18px rgba(0,0,0,.7);color-scheme:dark}}
:root[data-theme="dark"]{--bg:#171513;--ink:#f2ede4;--mute:#b0a799;--line:#35302a;--oak:#d9955a;--card:#211e1a;--shadow:0 1px 2px rgba(0,0,0,.4),0 18px 40px -18px rgba(0,0,0,.7);color-scheme:dark}
*{box-sizing:border-box}html{height:100%;scroll-behavior:smooth;scroll-padding-top:90px}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.65 'DM Sans',system-ui,-apple-system,'Segoe UI',sans-serif;-webkit-font-smoothing:antialiased}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--bg)}
h1,h2{font-family:'DM Serif Display',Georgia,'Times New Roman',serif;font-weight:400;line-height:1.08;letter-spacing:-.01em;margin:0}
a{color:inherit}img{max-width:100%}
.eyebrow,.info .eyebrow{font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--oak);margin:0 0 14px}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:9;display:flex;align-items:center;gap:28px;padding:16px max(5vw,calc((100vw - 1180px)/2));background:color-mix(in srgb,var(--bg) 90%,transparent);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.logo{font-family:'DM Serif Display',Georgia,serif;font-size:22px;letter-spacing:.18em;text-decoration:none;margin-right:auto}
nav{display:flex;gap:28px}nav a{text-decoration:none;color:var(--mute);font-size:15px;font-weight:500;padding:6px 0;border-bottom:2px solid transparent;transition:color .2s,border-color .2s}nav a:hover{color:var(--ink);border-color:var(--oak)}
button{font:inherit;cursor:pointer}
.cartbtn{background:none;border:1px solid var(--line);color:var(--ink);padding:9px 18px;border-radius:99px;font-weight:500;min-height:44px;transition:border-color .2s,background .2s}.cartbtn:hover{border-color:var(--ink)}
.btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;background:var(--ink);color:var(--bg);padding:12px 26px;border-radius:99px;text-decoration:none;border:1px solid var(--ink);font-weight:500;transition:background .2s,border-color .2s,color .2s}
.btn:hover{background:var(--oak);border-color:var(--oak);color:#fff}
.btn.alt{background:none;color:var(--ink);border-color:var(--line)}.btn.alt:hover{background:none;color:var(--ink);border-color:var(--ink)}
.hero{max-width:1180px;margin:auto;padding:9vh 5vw 8vh;display:grid;grid-template-columns:1fr 1.05fr;gap:5vw;align-items:center}
.hero h1{font-size:clamp(42px,6vw,78px);max-width:11ch}
.hero .lead{max-width:44ch;color:var(--mute);font-size:19px;margin:22px 0 32px}
.cta{display:flex;flex-wrap:wrap;gap:12px}
.hero-img{aspect-ratio:4/3;border-radius:16px;background:var(--line) center/cover no-repeat;box-shadow:var(--shadow)}
.prod{max-width:1180px;margin:auto;padding:9vh 5vw;display:grid;grid-template-columns:1.1fr 1fr;gap:5vw;align-items:center;border-top:1px solid var(--line)}
#mesa{grid-template-columns:1fr 1.1fr}#mesa .gal{order:2}
.gal .main{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:14px;background:var(--line);display:block;box-shadow:var(--shadow)}
.thumbs{display:grid;grid-template-columns:repeat(auto-fill,minmax(62px,1fr));gap:8px;margin-top:10px}
.thumbs button{padding:0;border:2px solid transparent;border-radius:8px;overflow:hidden;background:none;line-height:0;opacity:.72;transition:opacity .2s,border-color .2s}
.thumbs button:hover{opacity:1}.thumbs button[aria-current=true]{border-color:var(--oak);opacity:1}
.thumbs img{width:100%;aspect-ratio:4/3;object-fit:cover}
.info h2{font-size:clamp(30px,3.6vw,44px)}
.price{font-size:30px;font-weight:700;margin:14px 0 16px;font-variant-numeric:tabular-nums}
.info p{color:var(--mute)}.info ul{list-style:none;padding:0;margin:18px 0 26px;border-top:1px solid var(--line)}
.info li{padding:10px 0 10px 24px;border-bottom:1px solid var(--line);position:relative}
.info li::before{content:"";position:absolute;left:2px;top:19px;width:10px;height:2px;background:var(--oak)}
.opt{margin:0 0 20px;display:flex;flex-wrap:wrap;gap:10px;align-items:center}.opt label{font-weight:500}
select,input,textarea{font:inherit;padding:11px 14px;min-height:44px;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--ink)}
select:hover,input:hover,textarea:hover{border-color:var(--mute)}
.info .btn{width:100%}
.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;max-width:1180px;margin:0 auto;padding:0 5vw 9vh}
.facts div{background:var(--card);border:1px solid var(--line);border-top:3px solid var(--oak);border-radius:12px;padding:22px}
.facts b{display:block;font-size:17px;margin-bottom:4px}.facts span{color:var(--mute);font-size:15px}
.story{max-width:1180px;margin:auto;padding:10vh 5vw;border-top:1px solid var(--line)}
.story h2{font-size:clamp(32px,5vw,54px);margin-bottom:16px}.story p{max-width:50ch;color:var(--mute);margin:0 0 12px}
#contacto{display:grid;grid-template-columns:1fr 1fr;column-gap:6vw;align-content:start}
#contacto form{grid-column:2;grid-row:1/span 3;margin:0;padding:28px;background:var(--card);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow)}
form{display:grid;gap:12px}
textarea{resize:vertical;width:100%}input{width:100%}
.fmsg{margin:0;font-size:14px;color:var(--oak);min-height:1.2em}
footer{border-top:1px solid var(--line);color:var(--mute);font-size:14px}
.foot{max-width:1180px;margin:auto;padding:28px 5vw;display:flex;flex-wrap:wrap;gap:12px 32px;justify-content:space-between;align-items:center}
.foot .logo{font-size:18px;margin:0;color:var(--ink)}
.scrim{position:fixed;inset:0;background:rgba(20,18,15,.5);opacity:0;visibility:hidden;transition:opacity .25s,visibility 0s .25s;z-index:20}
.scrim.show{opacity:1;visibility:visible;transition:opacity .25s}
.drawer{position:fixed;top:0;right:0;bottom:0;width:min(400px,100%);background:var(--card);border-left:1px solid var(--line);padding:calc(22px + env(safe-area-inset-top,0px)) 24px calc(22px + env(safe-area-inset-bottom,0px));transform:translateX(100%);visibility:hidden;transition:transform .28s,visibility 0s .28s;z-index:30;display:flex;flex-direction:column;box-shadow:var(--shadow)}
.drawer.open{transform:none;visibility:visible;transition:transform .28s}
.drawer ul{list-style:none;padding:0;margin:18px 0;flex:1;overflow:auto}
.drawer li{display:flex;justify-content:space-between;gap:12px;padding:14px 0;border-bottom:1px solid var(--line)}
.drawer li button{background:none;border:0;color:var(--mute);text-decoration:underline;padding:0 0 0 8px}
.drawer .btn{width:100%}
.tot{display:flex;justify-content:space-between;font-weight:700;font-size:18px;margin-bottom:16px}
.top{display:flex;justify-content:space-between;align-items:center}.top button{background:none;border:1px solid var(--line);border-radius:99px;padding:6px 14px;color:var(--ink)}
:focus-visible{outline:2px solid var(--oak);outline-offset:3px}
@media(max-width:860px){.hero,.prod,#mesa{grid-template-columns:1fr}#mesa .gal{order:0}nav{display:none}.facts{grid-template-columns:1fr}#contacto{display:block}#contacto form{margin-top:24px}.hero{padding-top:6vh}}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
<body>
<header><a class="logo" href="#">OAKLAND</a>
<nav><a href="#sofa">Sofá cama</a><a href="#mesa">Mesa de comedor</a><a href="#historia">Nosotros</a><a href="#contacto">Contacto</a></nav>
<button class="cartbtn" id="open">Carrito (<span id="n">0</span>)</button></header>

<section class="hero"><div class="hero-copy"><p class="eyebrow">Colección Oakland</p><h1>Sofá de día, cama de noche.</h1>
<p class="lead">Tapizado en pana gruesa, con rodillos y cojines incluidos. Se despliega en un momento y se guarda igual de rápido.</p>
<div class="cta"><a class="btn" href="#sofa">Ver el sofá cama</a><a class="btn alt" href="#contacto">Pedir información</a></div></div>
<div id="hero-img" class="hero-img" role="img" aria-label="Sofá cama Oakland en color crema"></div></section>

<section class="prod" id="sofa">
<div class="gal"><img class="main" data-big="2" src="data:image/jpeg;base64," alt="Sofá cama Oakland en color crema, visto de frente"><div class="thumbs" data-th="2"></div></div>
<div class="info"><p class="eyebrow">Sofás</p><h2>Sofá cama Oakland</h2><div class="price">395 €</div>
<p>Dos cojines cuadrados, rodillos laterales y asas para desplegarlo con facilidad. Estructura metálica negra y etiqueta de cuero.</p>
<ul><li>Tapizado de pana gruesa</li><li>Se convierte en cama</li><li>Disponible en gris y crema</li></ul>
<div class="opt"><label for="col">Color:</label><select id="col"><option>Crema</option><option>Gris</option></select></div>
<button class="btn" data-add="Sofá cama Oakland" data-price="395" data-opt="col">Añadir al carrito</button></div>
</section>

<section class="facts"><div><b>Dos en uno</b><span>Sofá para el día, cama para las visitas</span></div><div><b>Pana gruesa</b><span>Tacto suave y fácil de combinar</span></div><div><b>Estructura de metal</b><span>Marco negro con acabado mate</span></div></section>

<section class="prod" id="mesa">
<div class="gal"><img class="main" data-big="0" src="data:image/jpeg;base64," alt="Mesa de comedor Oakland de madera con sillas, vista lateral">
<div class="thumbs" data-th="0"></div></div>
<div class="info"><p class="eyebrow">Comedor</p><h2>Mesa de comedor con 6 sillas</h2><div class="price" id="p1">275 €</div>
<p>Conjunto nuevo de mesa de madera con acabado natural y seis sillas a juego, con asiento tapizado y estructura metálica.</p>
<ul><li>Mesa: 160 × 80 × 75 cm (largo, ancho, alto)</li><li>Madera con acabado natural</li><li>Seis sillas con asiento tapizado y patas de metal</li><li>Transporte a domicilio disponible</li></ul>
<div class="opt"><label for="col1">Color:</label><select id="col1"><option value="Beige">Beige</option><option value="Marrón">Marrón</option></select></div>
<div class="opt"><label for="sel1">Qué quieres:</label><select id="sel1"><option value="Mesa y 6 sillas" data-price="275">Mesa y 6 sillas · 275 €</option><option value="Solo la mesa" data-price="135">Solo la mesa · 135 €</option><option value="Solo las sillas" data-unit="35">Solo las sillas · 35 € / unidad</option></select><span id="qw1" hidden>× <input type="number" id="qty1" min="1" max="6" value="1" style="width:72px" aria-label="Número de sillas"> sillas</span></div>
<button class="btn" data-add="Mesa de comedor con 6 sillas" data-price="275" data-opt="sel1" data-color="col1">Añadir al carrito</button></div>
</section>

<section class="prod" id="mesa2">
<div class="gal"><img class="main" data-big="1" src="data:image/jpeg;base64," alt="Mesa de comedor de madera clara con sillas de asiento beige"><div class="thumbs" data-th="1"></div></div>
<div class="info"><p class="eyebrow">Comedor</p><h2>Mesa de comedor con 4 sillas</h2><div class="price" id="p2">225 €</div>
<p>Mesa de madera con cuatro sillas de respaldo de madera, asiento tapizado y estructura metálica negra, en beige o marrón. Puedes llevarte el conjunto completo o solo una de las dos piezas.</p>
<ul><li>Mesa de madera, disponible en beige y marrón</li><li>Sillas con asiento tapizado y patas de metal</li><li>Elige: conjunto, solo la mesa o solo las sillas</li></ul>
<div class="opt"><label for="col2">Color:</label><select id="col2"><option value="Beige">Beige</option><option value="Marrón">Marrón</option></select></div>
<div class="opt"><label for="sel2">Qué quieres:</label><select id="sel2"><option value="Mesa y 4 sillas" data-price="225">Mesa y 4 sillas · 225 €</option><option value="Solo la mesa" data-price="125">Solo la mesa · 125 €</option><option value="Solo las sillas" data-unit="35">Solo las sillas · 35 € / unidad</option></select><span id="qw2" hidden>× <input type="number" id="qty2" min="1" max="12" value="1" style="width:72px" aria-label="Número de sillas"> sillas</span></div>
<button class="btn" data-add="Mesa de comedor con 4 sillas" data-price="225" data-opt="sel2" data-color="col2">Añadir al carrito</button></div>
</section>

<section class="story" id="historia"><h2>Muebles con historia.</h2>
<p>En Oakland diseñamos piezas para vivirse todos los días: cómodas, versátiles y pensadas para espacios reales.</p>
<p>El sofá cama llega embalado en caja, listo para estrenar.</p></section>

<section class="story" id="contacto"><h2>¿Tienes dudas?</h2><p>Cuéntanos qué necesitas y te respondemos lo antes posible.</p>
<form onsubmit="event.preventDefault();document.getElementById('fmsg').textContent='Gracias. El formulario aún no está conectado, así que tu consulta no se ha enviado.'">
<input placeholder="Nombre" aria-label="Nombre"><input type="email" placeholder="Correo electrónico" aria-label="Correo electrónico"><textarea rows="4" placeholder="Tu consulta" aria-label="Tu consulta"></textarea>
<button class="btn" type="submit">Enviar consulta</button><p class="fmsg" id="fmsg" role="status"></p></form></section>

<footer><div class="foot"><span class="logo">OAKLAND</span><span>© 2026 OAKLAND · Tienda de ejemplo: el carrito y el formulario aún no están conectados.</span></div></footer>

<div class="scrim" id="scrim"></div>
<aside class="drawer" id="dr" aria-label="Carrito"><div class="top"><h2 style="font-size:28px">Tu carrito</h2><button id="close">Cerrar</button></div>
<ul id="items"></ul><div class="tot"><span>Total</span><span id="tot">0 €</span></div><button class="btn" onclick="alert('Finalizar pedido aún no está conectado.')">Finalizar pedido</button></aside>

<script>
const GALS=[["data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,"], ["data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,"], ["data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,"]];
GALS.forEach((g,k)=>{const big=document.querySelector('[data-big="'+k+'"]'),th=document.querySelector('[data-th="'+k+'"]');
g.forEach((s,i)=>{const b=document.createElement('button');b.innerHTML='<img src="'+s+'" alt="Foto '+(i+1)+'">';b.onclick=()=>{big.src=s;[...th.children].forEach(c=>c.removeAttribute('aria-current'));b.setAttribute('aria-current','true')};if(!i)b.setAttribute('aria-current','true');th.appendChild(b)})});
let cart=[];const $=id=>document.getElementById(id);
const eur=p=>p==null?'a consultar':p+' €';
function draw(){$('n').textContent=cart.length;$('tot').textContent=cart.reduce((a,c)=>a+(c.p||0),0)+' €'+(cart.some(c=>c.p==null)?' + a consultar':'');
$('items').innerHTML=cart.length?'':'<li>El carrito está vacío.</li>';
cart.forEach((c,i)=>{const li=document.createElement('li');li.innerHTML='<span>'+c.n+'</span><span>'+eur(c.p)+' <button>Quitar</button></span>';li.querySelector('button').onclick=()=>{cart.splice(i,1);draw()};$('items').appendChild(li)})}
document.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>{let p=+b.dataset.price,o='';if(b.dataset.opt){const s=$(b.dataset.opt),op=s.options[s.selectedIndex];const q=op.dataset.unit?Math.max(1,+$('qty'+s.id.slice(3)).value||1):0;o=' ('+op.value+(q?' ×'+q:'')+')';p=q?q*+op.dataset.unit:(op.dataset.price?+op.dataset.price:p)}cart.push({n:b.dataset.add+o+(b.dataset.color?' · '+$(b.dataset.color).value:''),p});draw();$('dr').classList.add('open')});
function upd(n){const s=$('sel'+n),op=s.options[s.selectedIndex],u=op.dataset.unit;$('qw'+n).hidden=!u;$('p'+n).textContent=u?(+u*Math.max(1,+$('qty'+n).value||1))+' €':op.dataset.price+' €'}[1,2].forEach(n=>{$('sel'+n).onchange=()=>upd(n);$('qty'+n).oninput=()=>upd(n)});$('col').onchange=()=>document.querySelector('[data-th="2"]').children[$('col').value==='Gris'?6:0].click();
$('open').onclick=()=>$('dr').classList.add('open');$('close').onclick=()=>$('dr').classList.remove('open');draw();
const GCOL={0:{'Beige':[6,7,8,9],'Marrón':[0,1,2,3,4,5]},1:{'Beige':[0,1,2],'Marrón':[3,4,5,6]}};
[[0,'col1'],[1,'col2']].forEach(([k,id])=>{const big=document.querySelector('[data-big="'+k+'"]'),th=document.querySelector('[data-th="'+k+'"]'),sel=$(id),alt0=big.alt;
const note=document.createElement('p');note.style.cssText='font-size:14px;color:var(--mute);margin:10px 0 0';note.hidden=true;th.after(note);
function show(){const c=sel.value;let idx=GCOL[k][c]||[];const has=idx.length>0;if(!has)idx=Object.values(GCOL[k]).flat();
note.hidden=has;note.textContent=has?'':'Aún no tenemos fotos en '+c.toLowerCase()+'; las imágenes mostradas son de otro color.';
big.alt=has?'Mesa de comedor con sillas, color '+c.toLowerCase():alt0;th.innerHTML='';
idx.forEach((gi,n)=>{const s=GALS[k][gi],b=document.createElement('button');b.innerHTML='<img src="'+s+'" alt="Foto '+(n+1)+'">';b.onclick=()=>{big.src=s;[...th.children].forEach(x=>x.removeAttribute('aria-current'));b.setAttribute('aria-current','true')};th.appendChild(b)});th.firstChild.click()}
sel.addEventListener('change',show);show()});

try{$('hero-img').style.backgroundImage='url('+GALS[2][0]+')'}catch(e){}
const dr=$('dr'),sc=$('scrim');const sync=()=>{const o=dr.classList.contains('open');sc.classList.toggle('show',o);dr.setAttribute('aria-hidden',o?'false':'true')};
new MutationObserver(sync).observe(dr,{attributes:true,attributeFilter:['class']});sync();
sc.onclick=()=>dr.classList.remove('open');document.addEventListener('keydown',e=>{if(e.key==='Escape')dr.classList.remove('open')});
</script>
</body></html>
